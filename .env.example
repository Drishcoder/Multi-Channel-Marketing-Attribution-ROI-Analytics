# Grito Labs: Environment Configuration Template
# Copy this file to .env and update with your actual values

# ─── DATABASE CONFIGURATION ───────────────────────────────────────────────────
DB_TYPE=postgresql              # Options: postgresql, duckdb
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=grito_labs

# For local development, use DuckDB (no setup required)
# DUCKDB_PATH=./data/analytics.duckdb

# ─── BACKEND API CONFIGURATION ────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true              # Set to false in production
API_VERSION=v1

# ─── FRONTEND CONFIGURATION ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
FRONTEND_PORT=5173

# ─── DATA & MOCK CONFIGURATION ────────────────────────────────────────────────
SEED_USERS_COUNT=1200           # Number of mock users to generate
SEED_CAMPAIGNS=8                 # Number of mock campaigns
SEED_TOUCHPOINTS_PER_USER=7     # Average touchpoints per user
SEED_CONVERSION_RATE=0.28        # 28% conversion rate

# ─── ATTRIBUTION MODEL DEFAULTS ───────────────────────────────────────────────
DEFAULT_ATTRIBUTION_MODEL=linear  # Options: first, last, linear
ATTRIBUTION_WINDOW_DAYS=30        # Days to look back for touchpoints

# ─── SECURITY & LOGGING ──────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production
LOG_LEVEL=INFO                    # Options: DEBUG, INFO, WARNING, ERROR
LOG_FILE=./logs/app.log

# ─── EXTERNAL APIs (Optional) ────────────────────────────────────────────────
# Uncomment if integrating with external data sources
# GOOGLE_ANALYTICS_API_KEY=your_api_key
# META_BUSINESS_ACCOUNT_ID=your_account_id
# FACEBOOK_ADS_ACCESS_TOKEN=your_token
